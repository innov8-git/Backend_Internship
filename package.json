{
  "name": "internship-portal-backend",
  "version": "1.0.0",
  "description": "Internship Portal Backend API - Node.js + Express + PostgreSQL + Prisma",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "seed": "node scripts/seed.js",
    "migrate": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:reset": "npx prisma migrate reset --force",
    "db:server": "node scripts/pg-server.mjs",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "winston": "^3.15.0",
    "joi": "^17.13.3",
    "hpp": "^0.2.3",
    "slugify": "^1.6.6",
    "uuid": "^10.0.0",
    "dayjs": "^1.11.13",
    "http-status-codes": "^2.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "socket.io": "^4.8.0",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "handlebars": "^4.7.8",
    "axios": "^1.7.7",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "prisma": "^6.1.0",
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "ISC"
}
