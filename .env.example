# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_portal?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/internship_portal_test?schema=public

# ============================================
# JWT / AUTH
# ============================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# BCRYPT
# ============================================
BCRYPT_SALT_ROUNDS=12

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# EMAIL (Nodemailer)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Internship Portal <noreply@alfre.com>"

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# FILE UPLOAD / CLOUD STORAGE
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
# Storage provider: local | s3 | gcs
STORAGE_PROVIDER=local
# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# ============================================
# GITHUB INTEGRATION
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/github/callback

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ============================================
# CLIENT URL (for email links)
# ============================================
CLIENT_URL=http://localhost:5173
