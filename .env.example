# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ============================================
# DATABASE — Supabase PostgreSQL
# ============================================
# Connection pooling URL (port 6543) — used at runtime
DATABASE_URL=postgresql://postgres.uciyhhbuzfystukuixgq:Alfre%40%23%232026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL (port 5432) — used by Prisma migrations only
DIRECT_URL=postgresql://postgres:Alfre%40%23%232026@db.uciyhhbuzfystukuixgq.supabase.co:5432/postgres

# ============================================
# JWT / AUTH
# ============================================
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=15m
# Note: JWT_REFRESH_SECRET is NOT used — refresh tokens are random bytes hashed with SHA-256 (not JWTs)
BCRYPT_SALT_ROUNDS=12

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# EMAIL (Nodemailer / SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Internship Portal <noreply@alfre.com>"

# ============================================
# REDIS (optional — for permission caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
STORAGE_PROVIDER=local

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ============================================
# CLIENT URL (for email links)
# ============================================
CLIENT_URL=http://localhost:5173

# ============================================
# GITHUB INTEGRATION (optional)
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/github/callback

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ============================================
# SEED DEFAULTS (used by scripts/seed-rbac.js only)
# ============================================
ADMIN_SEED_EMAIL=admin@alfre.com
ADMIN_SEED_PASSWORD=Admin@123456
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_REFRESH_SECRET
